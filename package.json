{
  "name": "open-speed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test \"tests/*.test.mjs\"",
    "models": "npm run models:normalize",
    "models:normalize": "blender -b --python scripts/normalize-models.py",
    "models:simplify": "node scripts/simplify-models.mjs",
    "models:compress": "node scripts/compress-models.mjs",
    "verify:file-dist": "node scripts/verify/make-file-dist.mjs",
    "verify:shot": "node scripts/verify/headless-shot.mjs",
    "verify:freecam": "node scripts/verify/freecam.mjs",
    "verify:looks": "node scripts/verify/looks.mjs",
    "verify:post": "node scripts/verify/post-compare.mjs",
    "verify:place": "node scripts/verify/place.mjs",
    "verify:model": "node scripts/verify/model-shot.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
